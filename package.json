{
  "name": "@aero123421/dsh-search-providers",
  "version": "0.3.2",
  "description": "DeepSeek Harnessの検索プロバイダーと追加検索ツール",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aero123421/dsh-search-providers.git"
  },
  "bugs": {
    "url": "https://github.com/Aero123421/dsh-search-providers/issues"
  },
  "homepage": "https://github.com/Aero123421/dsh-search-providers#readme",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "LICENSE.DeepSeek",
    "docs",
    "upstream.json"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "react",
        "react/jsx-runtime",
        "react-dom"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-tool-web": ">=0.2.1-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-web": ">=0.2.1-alpha.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-brand": ">=0.2.1-alpha.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-web": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-brand": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:compat": "node scripts/compat-check.mjs",
    "test:peers": "node scripts/peer-range-check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:native": "node scripts/native-check.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-config-editor": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-web": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-web": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.8.0",
    "clsx": "^2.1.1",
    "esbuild": "0.28.2",
    "immer": "^10.2.0",
    "playwright": "^1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "^7.8.5",
    "typescript": "6.0.3",
    "use-sync-external-store": "^1.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
